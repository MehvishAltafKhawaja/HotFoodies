@model ASPNETMVC.Models.valid

<div class="container">

     @using(Html.BeginForm(FormMethod.Post)){

        <div class="row">
          <div class="col-lg-4 col-md-6 col-sm-12">
              <div>
               @Html.DisplayName("Rollno")
              </div>
              <div class="text-danger">
                @Html.TextBox("Rollno","", new{@class="form-control"})
                @Html.ValidationMessage("Rollno")
              </div>

               <div>
               @Html.DisplayName("name")
              </div>
              <div class="text-danger">
                @Html.TextBox("name","", new{@class="form-control"})
                 @Html.ValidationMessage("name")
              </div>

               <div>
               @Html.DisplayName("DOB")
              </div>
              <div class="text-danger">
              <input asp-for="DOB" type="date" class="form-control" />
              </div>

               <div>
               @Html.DisplayName("email")
              </div>
              <div class="text-danger">
                @Html.TextBox("email","", new{@class="form-control"})
                 @Html.ValidationMessage("email")
              </div>

               <div>
               @Html.DisplayName("phone")
              </div>
              <div class="text-danger">
                @Html.TextBox("phone", "",new{@class="form-control"})
                 @Html.ValidationMessage("phone")
              </div>
               
              <div class="mt-5">
                <input class="btn btn-info text-yellow" type="submit" value="Submit"/>
              </div>
          </div>
        </div>
    }
</div>