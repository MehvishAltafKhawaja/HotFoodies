@{
    ViewData["Title"] = "Home";
}

<link href="~/CSS/index.css" rel="stylesheet" type="text/css" />


<!-- =====================================
     HERO / CAROUSEL
====================================== -->

<section class="hero-section">

    <div id="carouselExampleCaptions"
         class="carousel slide hero-carousel"
         data-bs-ride="carousel">

        <!-- INDICATORS -->
        <div class="carousel-indicators">

            <button type="button"
                    data-bs-target="#carouselExampleCaptions"
                    data-bs-slide-to="0"
                    class="active"
                    aria-current="true"
                    aria-label="Slide 1">
            </button>

            <button type="button"
                    data-bs-target="#carouselExampleCaptions"
                    data-bs-slide-to="1"
                    aria-label="Slide 2">
            </button>

            <button type="button"
                    data-bs-target="#carouselExampleCaptions"
                    data-bs-slide-to="2"
                    aria-label="Slide 3">
            </button>

        </div>


        <!-- SLIDES -->
        <div class="carousel-inner">

            <!-- SLIDE 1 -->
            <div class="carousel-item active">

                <img src="~/images/img1.jpg"
                     class="d-block w-100"
                     alt="Fresh Food" />

                <div class="carousel-overlay"></div>

                <div class="carousel-caption">

                    <span class="hero-badge">
                        FRESH & DELICIOUS
                    </span>

                    <h1>
                        Taste Food You'll
                        <span>Love</span>
                    </h1>

                    <p>
                        Discover delicious meals prepared with
                        fresh ingredients and amazing flavours.
                    </p>

                    <a href="#popular-foods"
                       class="hero-btn">

                        Explore Foods →

                    </a>

                </div>

            </div>


            <!-- SLIDE 2 -->
            <div class="carousel-item">

                <img src="~/images/img2.jpg"
                     class="d-block w-100"
                     alt="Delicious Meals" />

                <div class="carousel-overlay"></div>

                <div class="carousel-caption">

                    <span class="hero-badge">
                        PREMIUM QUALITY
                    </span>

                    <h1>
                        Fresh Ingredients,
                        <span>Better Taste</span>
                    </h1>

                    <p>
                        Great food starts with quality ingredients
                        and careful preparation.
                    </p>

                    <a href="#popular-foods"
                       class="hero-btn">

                        View Menu →

                    </a>

                </div>

            </div>


            <!-- SLIDE 3 -->
            <div class="carousel-item">

                <img src="~/images/img3.png"
                     class="d-block w-100"
                     alt="Food Collection" />

                <div class="carousel-overlay"></div>

                <div class="carousel-caption">

                    <span class="hero-badge">
                        MADE FOR FOODIES
                    </span>

                    <h1>
                        Your Favourite Food,
                        <span>One Place</span>
                    </h1>

                    <p>
                        Burgers, pizza, biryani, pasta and much
                        more waiting for you.
                    </p>

                    <a href="#popular-foods"
                       class="hero-btn">

                        Order Now →

                    </a>

                </div>

            </div>

        </div>


        <!-- PREVIOUS -->
        <button class="carousel-control-prev"
                type="button"
                data-bs-target="#carouselExampleCaptions"
                data-bs-slide="prev">

            <span class="carousel-control-prev-icon"
                  aria-hidden="true">
            </span>

            <span class="visually-hidden">
                Previous
            </span>

        </button>


        <!-- NEXT -->
        <button class="carousel-control-next"
                type="button"
                data-bs-target="#carouselExampleCaptions"
                data-bs-slide="next">

            <span class="carousel-control-next-icon"
                  aria-hidden="true">
            </span>

            <span class="visually-hidden">
                Next
            </span>

        </button>

    </div>

</section>



<!-- =====================================
     WELCOME SECTION
====================================== -->

<section class="welcome-section">

    <div class="welcome-content">

        <span class="section-small-title">
            WELCOME TO OUR WEB APP
        </span>

        <h2>
            Food Made With
            <span>Love & Quality</span>
        </h2>

        <p>
            Explore our collection of delicious food,
            discover your favourites and enjoy meals
            prepared to satisfy every craving.
        </p>

    </div>

</section>



<!-- =====================================
     FEATURE BOXES
====================================== -->

<section class="features-section">

    <div class="features-container">


        <div class="feature-card">

            <div class="feature-icon">
                ✓
            </div>

            <div>
                <h3>Fresh Food</h3>

                <p>
                    Fresh ingredients selected for
                    better taste and quality.
                </p>
            </div>

        </div>


        <div class="feature-card">

            <div class="feature-icon">
                ★
            </div>

            <div>
                <h3>Best Quality</h3>

                <p>
                    Delicious food prepared with
                    quality and care.
                </p>
            </div>

        </div>


        <div class="feature-card">

            <div class="feature-icon">
                ₹
            </div>

            <div>
                <h3>Affordable Prices</h3>

                <p>
                    Great food at prices that
                    everyone can enjoy.
                </p>
            </div>

        </div>


    </div>

</section>



<!-- =====================================
     POPULAR FOOD SECTION
====================================== -->

<section class="index-product"
         id="popular-foods">

    <div class="product-heading">

        <span class="section-small-title">
            OUR MENU
        </span>

        <h2>
            Our <span>Popular Foods</span>
        </h2>

        <p>
            Fresh, delicious and made just for you.
        </p>

    </div>


    <div class="product-container">


        <!-- CARD 1 -->
        <div class="food-card">

            <div class="food-image">

                <img src="~/images/burger.png"
                     alt="Classic Burger" />

                <span class="food-badge">
                    Popular
                </span>

            </div>

            <div class="food-card-body">

                <h3>Classic Burger</h3>

                <p>
                    Juicy grilled burger with fresh vegetables,
                    cheese and our special sauce.
                </p>

                <div class="food-card-footer">

                    <div>
                        <small>Price</small>
                        <span class="price">₹199</span>
                    </div>

                    <a href="#"
                       class="order-btn">

                        Order Now

                    </a>

                </div>

            </div>

        </div>



        <!-- CARD 2 -->
        <div class="food-card">

            <div class="food-image">

                <img src="~/images/Margherita-Pizza.png"
                     alt="Cheese Pizza" />

                <span class="food-badge">
                    Bestseller
                </span>

            </div>

            <div class="food-card-body">

                <h3>Cheese Pizza</h3>

                <p>
                    Loaded with mozzarella cheese,
                    tomato sauce and delicious fresh toppings.
                </p>

                <div class="food-card-footer">

                    <div>
                        <small>Price</small>
                        <span class="price">₹299</span>
                    </div>

                    <a href="#"
                       class="order-btn">

                        Order Now

                    </a>

                </div>

            </div>

        </div>



        <!-- CARD 3 -->
        <div class="food-card">

            <div class="food-image">

                <img src="~/images/pasta.jpg"
                     alt="Creamy Pasta" />

            </div>

            <div class="food-card-body">

                <h3>Creamy Pasta</h3>

                <p>
                    Rich and creamy pasta prepared with
                    herbs, vegetables and special sauce.
                </p>

                <div class="food-card-footer">

                    <div>
                        <small>Price</small>
                        <span class="price">₹249</span>
                    </div>

                    <a href="#"
                       class="order-btn">

                        Order Now

                    </a>

                </div>

            </div>

        </div>



        <!-- CARD 4 -->
        <div class="food-card">

            <div class="food-image">

                <img src="~/images/beryani.jpg"
                     alt="Chicken Biryani" />

                <span class="food-badge">
                    Hot
                </span>

            </div>

            <div class="food-card-body">

                <h3>Chicken Biryani</h3>

                <p>
                    Aromatic basmati rice cooked with
                    tender chicken and traditional spices.
                </p>

                <div class="food-card-footer">

                    <div>
                        <small>Price</small>
                        <span class="price">₹349</span>
                    </div>

                    <a href="#"
                       class="order-btn">

                        Order Now

                    </a>

                </div>

            </div>

        </div>



        <!-- CARD 5 -->
        <div class="food-card">

            <div class="food-image">

                <img src="~/images/sandwish.jpg"
                     alt="Club Sandwich" />

            </div>

            <div class="food-card-body">

                <h3>Club Sandwich</h3>

                <p>
                    Fresh toasted bread filled with vegetables,
                    cheese and delicious sauces.
                </p>

                <div class="food-card-footer">

                    <div>
                        <small>Price</small>
                        <span class="price">₹179</span>
                    </div>

                    <a href="#"
                       class="order-btn">

                        Order Now

                    </a>

                </div>

            </div>

        </div>



        <!-- CARD 6 -->
        <div class="food-card">

            <div class="food-image">

                <img src="~/images/noodles.jpg"
                     alt="Veg Noodles" />

            </div>

            <div class="food-card-body">

                <h3>Veg Noodles</h3>

                <p>
                    Stir-fried noodles tossed with fresh
                    vegetables and flavorful Asian sauces.
                </p>

                <div class="food-card-footer">

                    <div>
                        <small>Price</small>
                        <span class="price">₹229</span>
                    </div>

                    <a href="#"
                       class="order-btn">

                        Order Now

                    </a>

                </div>

            </div>

        </div>


    </div>

</section>



<!-- =====================================
     ADMIN SECTION
====================================== -->

<section class="admin-section">

    <div>

        <span class="section-small-title">
            ADMINISTRATION
        </span>

        <h2>
            Manage Your
            <span>Products</span>
        </h2>

        <p>
            Add new products, update existing records,
            check product details and manage your
            product inventory.
        </p>

    </div>


    <div class="admin-buttons">

        <a asp-action="ProductList"
           asp-controller="Product"
           class="manage-btn">

            Manage Products →

        </a>

        <a asp-action="Index"
           asp-controller="Admin"
           class="admin-btn">

            Admin Panel

        </a>

    </div>

</section>