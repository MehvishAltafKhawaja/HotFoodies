@{
    ViewData["Title"] = "Feedback";
}
<h2>@ViewData["Name"]</h2>
<link rel="stylesheet" href="~/CSS/feedback.css" asp-append-version="true" />

<h1>FeedBack 😎</h1>

<div class="fb-class">

    <div class="form-out">


        <form class="fb-from" name="fr" method="post" asp-action="SendMail" asp-controller="Home">

            <div>
                <label class="form-label">
                    To
                </label>

                <input type="email"
                       class="form-control text-white"
                       placeholder="Enter your email..." name="to" />
            </div>

            <div>
                <label class="form-label">
                    Subject
                </label>

                <input class="form-control text-white"
                          placeholder="Write your subject here..." name="subject" />
            </div>
            <div>
                <label class="form-label">
                    FeedBack
                </label>

                <textarea class="ta-fd text-white"
                          placeholder="Write your feedback here..." name="message"></textarea>
            </div>
            <button type="submit" class="btn btn-success">
                Submit Feedback
            </button>

        </form>

    </div>

</div>