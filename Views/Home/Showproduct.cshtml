@* Now we add multi item  *@

@model IEnumerable<ASPNETMVC.Models.Product>

<h1>
    Product Details
</h1>

<div class="container">
@{

   foreach(var productitem in Model)
   {
    <h3>ProdId: @productitem.prodid</h3>
    <h3>ProdName: @productitem.prodname</h3>
    <h3>ProdPrice: @productitem.prodprice</h3>
    <h3>ProdQty: @productitem.prodQty</h3>
   }
  
}
 <hr />
</div>