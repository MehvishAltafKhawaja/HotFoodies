@model ASPNETMVC.Models.ProductTable

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Create Product</title>

    <link rel="stylesheet" href="~/CSS/CreateProd.css" />
</head>

<body>

    <div class="create-page">

        <!-- PAGE HEADER -->
        <div class="page-header">

            <div>
                <h1>
                    Create <span>Product</span>
                </h1>

                <p>
                    Add a new product record to your product management system.
                </p>
            </div>

            <a asp-action="ProductList"
               asp-controller="Product"
               class="back-top-btn">
                ← Back to List
            </a>

        </div>


        <!-- CREATE CARD -->
        <div class="create-card">

            <!-- CARD HEADER -->
            <div class="card-header">

                <div class="create-icon">
                    +
                </div>

                <div>
                    <h2>New Product Information</h2>

                    <p>
                        Enter the product details below to create a new record.
                    </p>
                </div>

            </div>


            <!-- FORM -->
            <form asp-action="CreateProduct"
                  asp-controller="Product"
                  method="post">


                <!-- VALIDATION SUMMARY -->
                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>


                <div class="form-content">


                    <!-- PRODUCT ID -->
                    <div class="form-group">

                        <label asp-for="ProdId"></label>

                        <div class="input-wrapper">

                            <span class="input-icon">#</span>

                            <input asp-for="ProdId"
                                   class="form-control"
                                   placeholder="Enter Product ID" />

                        </div>

                        <span asp-validation-for="ProdId"
                              class="validation-message">
                        </span>

                    </div>


                    <!-- PRODUCT NAME -->
                    <div class="form-group">

                        <label asp-for="ProdName"></label>

                        <div class="input-wrapper">

                            <span class="input-icon">P</span>

                            <input asp-for="ProdName"
                                   class="form-control"
                                   placeholder="Enter Product Name" />

                        </div>

                        <span asp-validation-for="ProdName"
                              class="validation-message">
                        </span>

                    </div>


                    <!-- EXPIRY DATE -->
                    <div class="form-group">

                        <label asp-for="ProdExpire"></label>

                        <div class="input-wrapper">

                            <span class="input-icon">◷</span>

                            <input type="date"
                                   asp-for="ProdExpire"
                                   class="form-control" />

                        </div>

                        <span asp-validation-for="ProdExpire"
                              class="validation-message">
                        </span>

                    </div>


                    <!-- PRODUCT PRICE -->
                    <div class="form-group">

                        <label asp-for="ProdPrice"></label>

                        <div class="input-wrapper">

                            <span class="input-icon">₹</span>

                            <input asp-for="ProdPrice"
                                   class="form-control"
                                   placeholder="Enter Product Price" />

                        </div>

                        <span asp-validation-for="ProdPrice"
                              class="validation-message">
                        </span>

                    </div>


                    <!-- BATCH ID -->
                    <div class="form-group full-width">

                        <label asp-for="ProdBatchId"></label>

                        <div class="input-wrapper">

                            <span class="input-icon">B</span>

                            <input asp-for="ProdBatchId"
                                   class="form-control"
                                   placeholder="Enter Batch Number" />

                        </div>

                        <span asp-validation-for="ProdBatchId"
                              class="validation-message">
                        </span>

                    </div>

                </div>


                <!-- ACTION BUTTONS -->
                <div class="form-actions">

                    <a asp-action="ProductList"
                       asp-controller="Product"
                       class="cancel-btn">
                        Cancel
                    </a>

                    <button type="submit"
                            class="create-btn">
                        + Create Product
                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- VALIDATION SCRIPTS -->
    <partial name="_ValidationScriptsPartial" />

</body>

</html>