@model ASPNETMVC.Models.ProductTable

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Product Details</title>

    <link rel="stylesheet" href="~/CSS/Details.css" />
</head>

<body>

    <div class="details-page">

        <!-- PAGE HEADER -->
        <div class="page-header">

            <div>
                <h1>
                    Product <span>Details</span>
                </h1>

                <p>
                    View complete information about the selected product.
                </p>
            </div>

            <a asp-action="ProductList"
               class="back-top-btn">
                ← Back to List
            </a>

        </div>


        <!-- DETAILS CARD -->
        <div class="details-card">

            <!-- CARD HEADER -->
            <div class="details-header">

                <div class="details-icon">
                    📦
                </div>

                <div>
                    <h2>Product Information</h2>
                    <p>Complete details of this product record.</p>
                </div>

            </div>


            <!-- PRODUCT DETAILS -->
            <div class="details-content">


                <!-- PRODUCT ID -->
                <div class="detail-item">

                    <span class="detail-label">
                        Product ID
                    </span>

                    <span class="product-id">
                        @Html.DisplayFor(model => model.ProdId)
                    </span>

                </div>


                <!-- PRODUCT NAME -->
                <div class="detail-item">

                    <span class="detail-label">
                        Product Name
                    </span>

                    <span class="detail-value product-name">
                        @Html.DisplayFor(model => model.ProdName)
                    </span>

                </div>


                <!-- EXPIRY DATE -->
                <div class="detail-item">

                    <span class="detail-label">
                        Expiry Date
                    </span>

                    <span class="detail-value">
                        @Html.DisplayFor(model => model.ProdExpire)
                    </span>

                </div>


                <!-- PRODUCT PRICE -->
                <div class="detail-item">

                    <span class="detail-label">
                        Product Price
                    </span>

                    <span class="product-price">
                        ₹ @Html.DisplayFor(model => model.ProdPrice)
                    </span>

                </div>


                <!-- BATCH ID -->
                <div class="detail-item">

                    <span class="detail-label">
                        Batch ID
                    </span>

                    <span class="batch-badge">
                        @Html.DisplayFor(model => model.ProdBatchId)
                    </span>

                </div>

            </div>


            <!-- ACTION BUTTONS -->
            <div class="details-actions">

                <a asp-action="ProductList"
                   class="back-btn">
                    ← Back to List
                </a>

                <a asp-action="Update"
                   asp-route-id="@Model.ProdId"
                   class="edit-btn">
                    ✎ Edit Product
                </a>

            </div>

        </div>

    </div>

</body>

</html>