
@model ASPNETMVC.Models.CreateProd

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Product Details</title>

    <link rel="stylesheet" href="~/CSS/Details.css" />
</head>

<body>

    <div class="details-page">

        <div class="details-card">

            <div class="details-header">
                <div class="details-icon">
                    📦
                </div>

                <div>
                    <h1>Product Details</h1>
                    <p>View product information</p>
                </div>
            </div>

            <div class="details-content">

                <div class="detail-item">
                    <span class="detail-label">
                        Product ID
                    </span>

                    <span class="detail-value">
                        @Html.DisplayFor(model => model.ProdId)
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">
                        Product Name
                    </span>

                    <span class="detail-value">
                        @Html.DisplayFor(model => model.prodname)
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">
                        Expiry Date
                    </span>

                    <span class="detail-value">
                        @Html.DisplayFor(model => model.Expire)
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">
                        Email
                    </span>

                    <span class="detail-value">
                        @Html.DisplayFor(model => model.email)
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">
                        Batch Number
                    </span>

                    <span class="detail-value">
                        @Html.DisplayFor(model => model.Batch)
                    </span>
                </div>

            </div>

            <div class="details-actions">

                <a asp-action="Edit"
                   asp-route-id="@Model.ProdId"
                   class="edit-btn">
                    ✏ Edit
                </a>

                <a asp-action="ProductList"
                   class="back-btn">
                    ← Back to List
                </a>

            </div>

        </div>

    </div>

</body>
</html>

