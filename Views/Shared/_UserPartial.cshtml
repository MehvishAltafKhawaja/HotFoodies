@using Microsoft.AspNetCore.Identity
@inject SignInManager<Users> signInManager;

<ul class="navbar-nav ms-auto">
@if(signInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link text-white" asp-controller="User" asp-action="Logout">Logout</a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-white" asp-controller="User" asp-action="Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white" asp-controller="User" asp-action="Login">Login</a>
        </li>
    }
</ul>