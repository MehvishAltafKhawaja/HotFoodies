<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Hot Foodies</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/ASPNETMVC.styles.css"
          asp-append-version="true" />
</head>

<body>

    <!-- =====================================
         HEADER / NAVBAR
    ====================================== -->

<header class="main-header">
    <nav class="navbar navbar-expand-lg custom-navbar">
        <div class="container-fluid px-lg-5">

            <!-- BRAND -->
            <a class="navbar-brand custom-brand"
               asp-area=""
               asp-controller="Home"
               asp-action="Index">
                <span class="brand-icon">H</span>
                <span>
                    Hot<span class="brand-green">Foodies</span>
                </span>
            </a>

            <!-- MOBILE TOGGLER -->
            <button class="navbar-toggler custom-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- NAVIGATION -->
            <div class="collapse navbar-collapse"
                 id="mainNavbar">

                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">

                    <!-- HOME -->
                    <li class="nav-item">
                        <a class="nav-link custom-nav-link"
                           asp-area=""
                           asp-controller="Home"
                           asp-action="Index">
                            Home
                        </a>
                    </li>

                    <!-- ABOUT -->
                    <li class="nav-item">
                        <a class="nav-link custom-nav-link"
                           asp-area=""
                           asp-controller="Home"
                           asp-action="AboutUs">
                            About
                        </a>
                    </li>

                    <!-- PRODUCTS -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle custom-nav-link"
                           href="#"
                           id="productDropdown"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            Products
                        </a>

                        <ul class="dropdown-menu custom-dropdown"
                            aria-labelledby="productDropdown">

                            <li>
                                <a class="dropdown-item"
                                   asp-area=""
                                   asp-controller="ProductScaffold"
                                   asp-action="Index">
                                    View Products
                                </a>
                            </li>

                            <li><hr class="dropdown-divider"></li>

                            <li>
                                <a class="dropdown-item"
                                   asp-area=""
                                   asp-controller="Product"
                                   asp-action="CreateProduct">
                                    + Add Product
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- EMPLOYEES -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle custom-nav-link"
                           href="#"
                           id="employeeDropdown"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            Employees
                        </a>

                        <ul class="dropdown-menu custom-dropdown"
                            aria-labelledby="employeeDropdown">

                            <li>
                                <a class="dropdown-item"
                                   asp-area=""
                                   asp-controller="Employee"
                                   asp-action="EmployeeList">
                                    Employee List
                                </a>
                            </li>

                            <li><hr class="dropdown-divider"></li>

                            <li>
                                <a class="dropdown-item"
                                   asp-area=""
                                   asp-controller="Employee"
                                   asp-action="EmployeeCreate">
                                    + Create Employee
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- USERS -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle custom-nav-link"
                           href="#"
                           id="userDropdown"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            Users
                        </a>

                        <ul class="dropdown-menu custom-dropdown"
                            aria-labelledby="userDropdown">

                            <li>
                                <a class="dropdown-item"
                                   asp-area=""
                                   asp-controller="User"
                                   asp-action="UserList">
                                    User List
                                </a>
                            </li>

                            <li><hr class="dropdown-divider"></li>

                            <li>
                                <a class="dropdown-item"
                                   asp-area=""
                                   asp-controller="User"
                                   asp-action="CreateUser">
                                    + Add User
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- CONTACT / INFORMATION -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle custom-nav-link"
                           href="#"
                           id="contactDropdown"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            Contact
                        </a>

                        <ul class="dropdown-menu custom-dropdown"
                            aria-labelledby="contactDropdown">

                            <li>
                                <a class="dropdown-item"
                                   asp-area=""
                                   asp-controller="Home"
                                   asp-action="FeedBack">
                                    Feedback
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-area=""
                                   asp-controller="Home"
                                   asp-action="Privacy">
                                    Privacy Policy
                                </a>
                            </li>
                        </ul>
                    </li>

                </ul>

                <!-- ACCOUNT / LOGIN -->
                <ul class="navbar-nav ms-lg-3 align-items-lg-center">
                    <partial name="_UserPartial" />
                </ul>

            </div>
        </div>
    </nav>
</header>



    <!-- =====================================
         MAIN CONTENT
    ====================================== -->

    <main role="main" class="main-content">

        @RenderBody()

    </main>


    <!-- =====================================
         FOOTER
    ====================================== -->

    <footer class="main-footer">

        <div class="container">

            <div class="footer-grid">


                <!-- COMPANY INFORMATION -->
                <div class="footer-section">

                    <div class="footer-logo">

                        <span class="brand-icon">P</span>

                        <span>
                            Product<span>Manager</span>
                        </span>

                    </div>

                    <p class="footer-description">

                        A simple and efficient product management
                        system built with ASP.NET Core MVC for
                        creating, updating, viewing and managing
                        product records.

                    </p>

                </div>


                <!-- QUICK LINKS -->
                <div class="footer-section">

                    <h4>Quick Links</h4>

                    <ul class="footer-links">

                        <li>
                            <a asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Product"
                               asp-action="ProductList">
                                Product List
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Home"
                               asp-action="AboutUs">
                                About
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Home"
                               asp-action="FeedBack">
                                Feedback
                            </a>
                        </li>

                    </ul>

                </div>


                <!-- PRODUCT MANAGEMENT -->
                <div class="footer-section">

                    <h4>Product Management</h4>

                    <ul class="footer-links">

                        <li>
                            <a asp-controller="Product"
                               asp-action="ProductList">
                                View Products
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Product"
                               asp-action="CreateProduct">
                                Add New Product
                            </a>
                        </li>

                    </ul>

                </div>


                <!-- INFORMATION -->
                <div class="footer-section">

                    <h4>Information</h4>

                    <p class="footer-info">
                        ASP.NET Core MVC
                    </p>

                    <p class="footer-info">
                        Product Management System
                    </p>

                    <p class="footer-info">
                        Version 1.0
                    </p>

                    <a asp-controller="Home"
                       asp-action="Privacy"
                       class="privacy-link">

                        Privacy Policy

                    </a>

                </div>

            </div>


            <!-- FOOTER BOTTOM -->

            <div class="footer-bottom">

                <p>
                    © @DateTime.Now.Year ProductManager.
                    All Rights Reserved.
                </p>

                <p>
                    Built with
                    <span>ASP.NET Core MVC</span>
                </p>

            </div>

        </div>

    </footer>


    <!-- =====================================
         SCRIPTS
    ====================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>
    <script>
        $(document).ready(function(){
        $("#district").prop("disabled", true);
        $(#state).change(function(){
            var id = $(#state).val();
            $.ajax({
                cache: false,
                type: "GET",
                url: '@Url.Action("GetDistrict","Employee")',
                data: {"id": id},
                success: function (json, textStatus){
                    $("#district").empty();
                    json = json || {};
                    for (var i = 0; i <json.length; i++)
                    {
                            $("#district").append(
                            '<option value="' +
                            item.districtId +
                            '">' +
                            item.districtName +
                            '</option>'
                        );

                    });

                    $("#district").prop("disabled", false);
                },

                error: function () {
                    alert("Data Not Found!");
                }
            });

        });

    });
</script>
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>