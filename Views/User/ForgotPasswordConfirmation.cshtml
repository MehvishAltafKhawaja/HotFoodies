
@{
    ViewData["Title"] = "Forgot Password Confirmation";
}

<link rel="stylesheet"
      href="~/css/forgotpasswordconfirmation.css"
      asp-append-version="true" />

<div class="confirmation-page">

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h1>
                Check Your <span>Email</span>
            </h1>
            <p>Password recovery confirmation</p>
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="back-btn">
            ← Home
        </a>
    </div>

    <!-- Confirmation Card -->
    <div class="confirmation-card">

        <div class="confirmation-card-header">

            <div class="confirmation-icon">
                ✉️
            </div>

            <h2>Check Your Inbox</h2>

            <p>
                Your password reset request
                has been received.
            </p>

        </div>

        <!-- Confirmation Body -->
        <div class="confirmation-card-body">

            <div class="success-icon">
                ✓
            </div>

            <h3>Reset Instructions Requested</h3>

            <p class="confirmation-message">
                If an account exists with the email
                address you provided, we have sent
                instructions to reset your password.
            </p>

            <div class="info-box">
                <span class="info-icon">ℹ️</span>

                <p>
                    Please check your inbox and spam
                    or junk folder for the password
                    reset email.
                </p>
            </div>

            <p class="security-message">
                For your security, never share your
                password reset link with anyone.
            </p>

            <!-- Back to Login -->
            <a asp-controller="User"
               asp-action="Login"
               class="login-btn">
                ← Back to Login
            </a>

            <div class="footer-message">
                <p>
                    Didn't receive an email?
                    <a asp-controller="User"
                       asp-action="ForgotPassword">
                        Try Again
                    </a>
                </p>
            </div>

        </div>

        <!-- Card Footer -->
        <div class="confirmation-card-footer">
            <p>
                © @DateTime.Now.Year HotFoodies.
                All rights reserved.
            </p>
        </div>

    </div>
</div>
