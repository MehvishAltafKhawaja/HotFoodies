
@{
    ViewData["Title"] = "Password Reset Successful";
}

<link rel="stylesheet"
      href="~/css/resetpassword.css"
      asp-append-version="true" />

<div class="reset-page">
    <div class="reset-card">

        <div class="reset-card-header">
            <div class="reset-icon">✅</div>

            <div>
                <h2>Password Reset Successful!</h2>
                <p>Your account password has been updated.</p>
            </div>
        </div>

        <div class="reset-card-body text-center">

            <h3 class="text-success mb-3">
                Password Changed Successfully
            </h3>

            <p class="text-white mb-4">
                You can now log in to your HotFoodies
                account using your new password.
            </p>

            <a asp-controller="User"
               asp-action="Login"
               class="reset-submit-btn d-inline-block text-center text-decoration-none">
                Login Now →
            </a>

        </div>
    </div>
</div>
