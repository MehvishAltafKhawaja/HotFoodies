
@model ASPNETMVC.ViewModel.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<link rel="stylesheet"
      href="~/css/resetpassword.css"
      asp-append-version="true" />

<div class="reset-page">

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h1>
                Reset Your <span>Password</span>
            </h1>
            <p>Create a new secure password for your account</p>
        </div>

        <a asp-controller="User"
           asp-action="Login"
           class="back-btn">
            ← Back to Login
        </a>
    </div>

    <!-- Reset Password Card -->
    <div class="reset-card">

        <!-- Card Header -->
        <div class="reset-card-header">

            <div class="reset-icon">
                🔐
            </div>

            <div>
                <h2>Create New Password</h2>
                <p>
                    Enter your new password below
                    to securely reset your account password.
                </p>
            </div>

        </div>

        <!-- Card Body -->
        <div class="reset-card-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            <form asp-controller="User"
                  asp-action="ResetPassword"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <!-- Hidden Token -->
                <input asp-for="Token" type="hidden" />

                <!-- Email -->
                <div class="mb-4">
                    <label asp-for="Email"
                           class="form-label">
                        EMAIL ADDRESS
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           readonly />
                </div>

                <!-- New Password -->
                <div class="mb-4">

                    <label asp-for="Password"
                           class="form-label">
                        NEW PASSWORD
                    </label>

                    <div class="input-wrapper">
                        <span class="input-icon">🔒</span>

                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               placeholder="Enter new password"
                               autocomplete="new-password" />
                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>
                </div>

                <!-- Confirm Password -->
                <div class="mb-4">

                    <label asp-for="ConfirmPassword"
                           class="form-label">
                        CONFIRM NEW PASSWORD
                    </label>

                    <div class="input-wrapper">
                        <span class="input-icon">🔐</span>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="form-control"
                               placeholder="Confirm new password"
                               autocomplete="new-password" />
                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger">
                    </span>
                </div>

                <!-- Submit Button -->
                <button type="submit"
                        class="reset-submit-btn">
                    Reset Password →
                </button>

                <!-- Login Link -->
                <div class="text-center mt-4">
                    <p class="login-footer-text">
                        Remember your password?

                        <a asp-controller="User"
                           asp-action="Login"
                           class="login-link">
                            Back to Login
                        </a>
                    </p>
                </div>

            </form>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
